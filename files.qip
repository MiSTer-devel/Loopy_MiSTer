# SYNTHESIS selects the altddio_out/altddio_in I/O-cell capture path in
# rtl/mem/sdram.sv. Quartus does not define it on its own; without it the
# fabric-clock simulation model is synthesized instead, and CAS_READ_CYCLES
# in sdram.sv is tuned against the I/O-cell path.
set_global_assignment -name VERILOG_MACRO "SYNTHESIS=1"

# rtl/mem/sdram.sdc derives the SDRAM_CLK pin clock from the PLL output, so it
# must follow the core SDC that runs derive_pll_clocks.
set_global_assignment -name SDC_FILE Loopy.sdc
set_global_assignment -name SDC_FILE rtl/mem/sdram.sdc
